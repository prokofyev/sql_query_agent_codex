# Подключение к локальному PostgreSQL с демо-базой products
SQA_DATABASE__DSN=postgresql://postgresql@localhost:5432/products

# Схемы в базе products
SQA_DATABASE__SCHEMA_NAME=public
SQA_DATABASE__AGENT_SCHEMA=agent
SQA_DATABASE__METRICS_SCHEMA=metrics

# GigaChat
SQA_GIGACHAT__CREDENTIALS=
SQA_GIGACHAT__SCOPE=GIGACHAT_API_PERS
SQA_GIGACHAT__MODEL=GigaChat
SQA_GIGACHAT__VERIFY_SSL=true

# Проверка имён
SQA_VALIDATION__FUZZY_THRESHOLD=65
SQA_VALIDATION__SUGGESTION_LIMIT=3

# Замер времени выполнения
SQA_MEASUREMENT__WARMUP_RUNS=1
SQA_MEASUREMENT__REPEAT_RUNS=3
SQA_MEASUREMENT__SIGNIFICANCE_RATIO=1.10

# Логирование
SQA_OBSERVABILITY__LOG_LEVEL=INFO
SQA_OBSERVABILITY__JSON_LOGS=false

# Библиотека предустановленных запросов
SQA_PRESETS__PATH=resources/presets.yaml

# Схема базы для панели в интерфейсе
SQA_SCHEMA__PATH=resources/schema.yaml
